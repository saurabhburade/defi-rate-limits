{
  "name": "defi-rate-limits",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/foundry",
      "packages/nextjs"
    ]
  },
  "scripts": {
    "account": "pnpm --filter @defi-rate-limits/foundry run account",
    "account:import": "pnpm --filter @defi-rate-limits/foundry run account:import",
    "account:generate": "pnpm --filter @defi-rate-limits/foundry run account:generate",
    "account:reveal-pk": "pnpm --filter @defi-rate-limits/foundry run account:reveal-pk",
    "chain": "pnpm --filter @defi-rate-limits/foundry run chain",
    "compile": "pnpm --filter @defi-rate-limits/foundry run compile",
    "deploy": "pnpm --filter @defi-rate-limits/foundry run deploy",
    "fork": "pnpm --filter @defi-rate-limits/foundry run fork",
    "format": "pnpm --filter @defi-rate-limits/nextjs run format && pnpm --filter @defi-rate-limits/foundry run format",
    "generate": "pnpm --filter @defi-rate-limits/foundry run account:generate",
    "lint": "pnpm --filter @defi-rate-limits/nextjs run lint && pnpm --filter @defi-rate-limits/foundry run lint",
    "next:build": "pnpm --filter @defi-rate-limits/nextjs run build",
    "next:check-types": "pnpm --filter @defi-rate-limits/nextjs run check-types",
    "postinstall": "husky",
    "precommit": "lint-staged",
    "start": "pnpm --filter @defi-rate-limits/nextjs run dev",
    "test": "pnpm --filter @defi-rate-limits/foundry run test",
    "verify": "pnpm --filter @defi-rate-limits/foundry run verify"
  },
  "pnpm": {
    "overrides": {
      "@coinbase/cdp-sdk": "1.51.2",
      "fast-xml-parser": "4.5.4",
      "form-data": "4.0.6",
      "protobufjs": "7.5.5",
      "sha.js": "2.4.12"
    }
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "engines": {
    "node": ">=20.18.3"
  }
}
